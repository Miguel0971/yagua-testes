{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "includeFiles": "{core.php,index.php,work.php,features.php,ui.php,cloud/**,views/**}",
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/assets/(app\\.css|theme\\.css|app\\.js|theme\\.js|favicon\\.svg)",
      "dest": "/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
